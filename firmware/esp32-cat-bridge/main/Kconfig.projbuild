menu "CAT Bridge Config"

    choice BRIDGE_BOARD
        prompt "Bridge board"
        default BRIDGE_BOARD_S3 if IDF_TARGET_ESP32S3
        default BRIDGE_BOARD_A1S
        help
            Which bridge hardware this build is for. Follows the target chip:
            `idf.py set-target esp32` builds the A1S, `esp32s3` the S3 board.

        config BRIDGE_BOARD_A1S
            bool "AI-Thinker ESP32-A1S Audio Kit (ES8388 codec)"
            depends on IDF_TARGET_ESP32

        config BRIDGE_BOARD_S3
            bool "ESP32-S3-N16R8 with WM8782 / PCM1808 / PCM5102"
            depends on IDF_TARGET_ESP32S3
            help
                See main/doc/S3_PORT_PLAN.md. The converters are brought up
                in stages; until then this board runs Wi-Fi, CAT, the PA
                watchdog and OTA with no audio.
    endchoice

    config BRIDGE_WIFI_SSID
        string "Wi-Fi SSID"
        default "myssid"
        help
            SSID of the home network the bridge joins in station mode.

    config BRIDGE_WIFI_PASSWORD
        string "Wi-Fi password"
        default "mypassword"
        help
            WPA2-PSK password for BRIDGE_WIFI_SSID. Stored in sdkconfig
            (not committed — see sdkconfig.defaults and .gitignore) since
            it's build-local secret configuration, same treatment as any
            other credential in this repo.

    config BRIDGE_WIFI_BSSID
        string "Wi-Fi BSSID pin (optional)"
        default ""
        help
            Pins the bridge to one specific access point's MAC address
            ("aa:bb:cc:dd:ee:ff" format) instead of letting esp_wifi pick
            any AP broadcasting BRIDGE_WIFI_SSID. Leave empty (the default)
            for normal behavior. Only needed on a network broadcasting the
            same SSID from multiple same-channel APs at similar signal
            strength — that setup was found to cause intermittent
            multi-second WiFi-layer stalls from roaming/co-channel
            contention, which this pin eliminates by removing the ambiguity
            about which physical AP to associate with. Overridable at
            runtime via POST /wifi-config (same as SSID/password) — this is
            only the first-boot fallback.



    config BRIDGE_CAT_UART_BAUD
        int "CAT UART baud rate"
        default 38400
        help
            Must match the baud rate configured in the radio's CAT menu
            (uSDX BLACK_BRICK: menu-selectable 9600-57600). Overridable at
            runtime later via a WS control message if needed; for now this
            is the boot-time default.

    config BRIDGE_AP_SSID
        string "Fallback AP SSID"
        default "usdx-bridge-setup"
        help
            SSID the bridge broadcasts on its own access point when it
            can't join BRIDGE_WIFI_SSID (see wifi_net.c's AP-fallback
            state). Fixed at build time, not user-editable via the control
            page or NVS — this is a recovery mechanism for when the normal
            network is unreachable, not a normal setting.

    config BRIDGE_AP_PASSWORD
        string "Fallback AP password"
        default "usdxbridge"
        help
            WPA2-PSK password for BRIDGE_AP_SSID. Must be empty (open
            network) or at least 8 characters — esp_wifi rejects shorter
            WPA2 passwords at esp_wifi_set_config() time.

endmenu
